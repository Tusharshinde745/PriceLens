# Session signing key. Set this to a long random string (python -c "import secrets; print(secrets.token_hex(32))").
SECRET_KEY=

# Copy this file to .env and fill in what you have. Keys stay on the server and never reach the browser.

# Flipkart Affiliate API: affiliate.flipkart.com > API > API Token
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# SerpApi (Google Shopping, India): covers Amazon.in, Croma, Reliance Digital and more. serpapi.com
SERPAPI_KEY=

# Optional: refresh live prices automatically every N minutes while app.py is running (0 = off).
# Each refresh uses about 16 SerpApi searches and 16 Flipkart calls, so mind your quota.
SYNC_INTERVAL_MIN=0
